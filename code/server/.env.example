# 复制为 code/server/.env 后按需修改。已有非空环境变量不会被本文件覆盖。
# 范围格式：min,max 或 min~max。非法配置会在启动时失败，不会静默钳制边界本身。

# --- case2：热力越界双边掐位；KPI 低于下限钳到 min，高于上限丢弃样本 ---
CASE2_RANGE_HEATMAP_RSS=-1,500
CASE2_RANGE_HEATMAP_EFFECTIVE_PATH_NUM=-1,500
CASE2_RANGE_HEATMAP_FIRST_PATH_DELAY=-1,1000
CASE2_RANGE_KPI_RSS=-1,1000
CASE2_RANGE_KPI_EFFECTIVE_PATH_NUM=-1,50000
CASE2_RANGE_KPI_FIRST_PATH_DELAY=-1,10000

# --- case3：占位，当前仍按代码内既有拒绝规则（Cost 0～100、beam 0～255 等）---
# CASE3_RANGE_COST=0,100
# CASE3_RANGE_BEAM=0,255

# --- case4：无专用范围环境变量；解析与 65535 规则见 doc/case4/SERVER-SPEC.md ---
# Reflection 由 Web 构建时 CASE4_REFLECTION_ENABLE / CASE4_BS_XYZ 控制展示与收齐 query；
# Node 开轮仍清理可选反射文件。详见 doc/case4/REFLECTION-SPEC.md。

# --- case1：RF 热力越界双边掐位（格子保留）；默认与 CASE2_RANGE_HEATMAP_RSS 一致 ---
CASE1_RANGE_HEATMAP_RSS=-1,500

# case1 文本在 DT_SHARED_DIR/case1；GLB 固定为 code/web/assets/case1/3D

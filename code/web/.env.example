
# case1：初始视角采用模型包围盒最长边归一为1、居中后的坐标，旋转为弧度。
# 交互只保留在本次case停留内；debug复制后手工改本文件，重启开发/重建生效。
VITE_CASE1_DEBUG=false
VITE_CASE1_GEOMETRY_CAMERA_POSITION=1,0.9,1
VITE_CASE1_GEOMETRY_CAMERA_TARGET=0,0,0
VITE_CASE1_GEOMETRY_CAMERA_ZOOM=1
VITE_CASE1_GEOMETRY_MODEL_ROTATION=0,0,0
VITE_CASE1_GEOMETRY_MODEL_SCALE=1
VITE_CASE1_GEOMETRY_PAN_SPEED=1
VITE_CASE1_GEOMETRY_ROTATE_SPEED=1
VITE_CASE1_GEOMETRY_ZOOM_SPEED=1
VITE_CASE1_MATERIAL_CAMERA_POSITION=1,0.9,1
VITE_CASE1_MATERIAL_CAMERA_TARGET=0,0,0
VITE_CASE1_MATERIAL_CAMERA_ZOOM=1
VITE_CASE1_MATERIAL_MODEL_ROTATION=0,0,0
VITE_CASE1_MATERIAL_MODEL_SCALE=1
VITE_CASE1_MATERIAL_PAN_SPEED=1
VITE_CASE1_MATERIAL_ROTATE_SPEED=1
VITE_CASE1_MATERIAL_ZOOM_SPEED=1

# 热力矩形左上角，单位是底图像素，原点在图片左上角
VITE_CASE1_HEATMAP_X0=539
VITE_CASE1_HEATMAP_Y0=287
# 热力矩形右下角，不含该像素。范围是 [X0, X1) × [Y0, Y1)，必须落在底图宽高之内
VITE_CASE1_HEATMAP_X1=874
VITE_CASE1_HEATMAP_Y1=479
# 每个色块的边长，单位像素
VITE_CASE1_HEATMAP_CELL=4
# 色块之间的透明缝，单位像素。周期 = CELL + GAP
VITE_CASE1_HEATMAP_GAP=0
# 热力叠在底图上的透明度，范围 (0, 1]
VITE_CASE1_HEATMAP_ALPHA=0.9

# Case2 热力图无效格 RGBA（各通道 0～255；默认全透明）
VITE_CASE2_HEATMAP_INVALID_R=255
VITE_CASE2_HEATMAP_INVALID_G=255
VITE_CASE2_HEATMAP_INVALID_B=255
VITE_CASE2_HEATMAP_INVALID_A=0

VITE_CASE1_HEATMAP_INVALID_R=255
VITE_CASE1_HEATMAP_INVALID_G=255
VITE_CASE1_HEATMAP_INVALID_B=255
VITE_CASE1_HEATMAP_INVALID_A=0

# RF 视图调试信息。0 仍可滚轮缩放、左键旋转、右键平移和复位，只是不显示可复制配置。1 才显示。
# 把复制出的四行贴回这里，重启后作为启动时的缩放、旋转和平移。
VITE_CASE1_RF_VIEW_DEBUG=0
VITE_CASE1_RF_VIEW_SCALE=1
VITE_CASE1_RF_VIEW_ROTATION_DEG=0
VITE_CASE1_RF_VIEW_OFFSET_X=0
VITE_CASE1_RF_VIEW_OFFSET_Y=0
# Case3 Reflection: configure the calibrated BS business coordinates to enable.
# Use true/false or 1/0. BS XYZ uses the same coordinate system as Case3 UE.
CASE3_REFLECTION_ENABLE=false
CASE3_BS_XYZ=

# Case3/Case4 独立相机／调试配置，其他 3D 参数共用：GLB 原生坐标，米；业务 (x,y,z) -> (x,z,-y)。
# 开启 debug，在界面调整后复制参数并替换此处，重启 dev / 重新 build。
VITE_CASE3_3D_DEBUG_INFO=false
VITE_CASE4_3D_DEBUG_INFO=false
# POSITION/TARGET 同时留空则自动适配模型范围。
VITE_CASE3_3D_CAMERA_POSITION=
VITE_CASE4_3D_CAMERA_POSITION=
VITE_CASE3_3D_CAMERA_TARGET=
VITE_CASE4_3D_CAMERA_TARGET=
VITE_CASE3_3D_CAMERA_ZOOM=1
VITE_CASE4_3D_CAMERA_ZOOM=1
VITE_DT_3D_PAN_SPEED=1
VITE_DT_3D_ROTATE_SPEED=1
VITE_DT_3D_ZOOM_SPEED=1
# Case3/Case4 3D，以及 Case1 几何层、电磁材质层两套 3D 的场景背景色。必须写成 "#RRGGBB"（带引号），否则 # 会被当成注释。不配或格式不对时用 #202832。
VITE_DT_3D_BACKGROUND_COLOR="#202832"
# Case3/Case4 3D Reflection 共用 BS 业务坐标；与 CASE3_BS_XYZ 同系。留空则各自 3D 回退 CASE3_BS_XYZ / CASE4_BS_XYZ。
VITE_DT_3D_BS_XYZ=

# Case2 六张地图统一初始视图；修改后重启 Web，部署时重新 build。
# 开启后在任意地图的全屏窗查看/复制参数，粘贴替换以下四项。
VITE_CASE2_MAP_DEBUG_INFO=false
VITE_CASE2_MAP_SCALE=1
VITE_CASE2_MAP_ROTATION_DEG=0
# 平移单位为视窗宽/高的百分比，兼容小卡片、全屏及窗口尺寸变化。
VITE_CASE2_MAP_OFFSET_X_PERCENT=0
VITE_CASE2_MAP_OFFSET_Y_PERCENT=0

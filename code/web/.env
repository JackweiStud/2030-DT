# --------case2------------
# case2 Web 构建时配置（Vite 注入；改完需重启 dev / 重新 build）
# 统一用本文件：dev / build 共用。不要再建 .env.development 覆盖同名项。
# （若存在 .env.local / .env.[mode].local，仍会按 Vite 规则覆盖本文件。）

# 控制文件串行轮询间隔（ms）；不是业务超时
# API 前缀写死同源 /api/case2（dev 由 Vite 代理到 127.0.0.1:3102），不进 env
VITE_CASE2_POLL_MS=1000

# 热力锚区（相对底图像素左上角）[X0,X1) × [Y0,Y1)
VITE_CASE2_HEATMAP_X0=750
VITE_CASE2_HEATMAP_Y0=400
VITE_CASE2_HEATMAP_X1=1200
VITE_CASE2_HEATMAP_Y1=700

# 马赛克：色块边长 + 透明缝（px）；周期 = CELL + GAP
VITE_CASE2_HEATMAP_CELL=4
VITE_CASE2_HEATMAP_GAP=1

# 热力层叠到底图的透明度 (0,1]
VITE_CASE2_HEATMAP_ALPHA=0.9

# CDF 显示点上限；N≤CAP 画完整台阶，N>CAP 才下采样
VITE_CASE2_CDF_POINT_CAP=256

# --------case3------------
# Start/ReInit 期间串行业务轮询间隔（ms）；不是业务超时
# API 前缀写死同源 /api/case3，不进 env
VITE_CASE3_POLL_MS=500

# ue_comm_map.png 标定原点（像素）
VITE_CASE3_MAP_ORIGIN_X=905
VITE_CASE3_MAP_ORIGIN_Y=445

# 1 px 对应的业务坐标单位m，文件 x/y 到图片 XY 时交换轴
VITE_CASE3_MAP_UNITS_PER_PX=0.11

# --------case3 V2 新界面------------

# case3-v2 2D 底图标定：客户物理世界坐标 (0,0) 在 site-2d.jpg 原图自然像素坐标系中的 X/Y。
# 注意：这是相对原图 naturalWidth/naturalHeight 的像素，不是页面显示后的 CSS 像素。
VITE_CASE3_V2_MAP_ORIGIN_X=916
VITE_CASE3_V2_MAP_ORIGIN_Y=608

# case3-v2 2D 底图标定：1 px 对应的业务坐标单位 m。
# 文件 UE(x,y,z) 映射到 2D 图时：imageX = originX + y / unitsPerPx，imageY = originY + x / unitsPerPx；z 不参与 2D 平面定位。
VITE_CASE3_V2_MAP_UNITS_PER_PX=0.11

# case3-v2 2D 底图显示调整：对“底图 + 路线 + 点位 + UE”整体图层做显示缩放。
# 不改变 originX/originY 的原图标定含义。
VITE_CASE3_V2_MAP_IMAGE_SCALE=1.6

# case3-v2 2D 底图显示调整：对整体图层做旋转，单位 deg。
# 不改变 originX/originY 的原图标定含义。
VITE_CASE3_V2_MAP_IMAGE_ROTATION_DEG=0

# case3-v2 2D 底图显示调整：整体图层在 V2 舞台中的显示平移，单位 CSS px。
# 不改变 originX/originY 的原图标定含义。
VITE_CASE3_V2_MAP_IMAGE_OFFSET_X=205
VITE_CASE3_V2_MAP_IMAGE_OFFSET_Y=-400

# case3-v2 2D 地图调参窗口：1 显示，0 隐藏；默认显示。
VITE_CASE3_V2_DEBUG_SHOW=0

# --------case4------------
# Start/ReInit 期间串行业务轮询间隔（ms）；不是业务超时
# API 前缀写死同源 /api/case4，不进 env
VITE_CASE4_POLL_MS=500

# case4 2D 底图标定：客户物理世界坐标 (0,0) 在 site-2d.jpg 原图自然像素坐标系中的 X/Y。
# 与现行 case3-v2 运行标定相同场地，但使用独立键，避免通信标定改动误伤定位页。
VITE_CASE4_MAP_ORIGIN_X=916
VITE_CASE4_MAP_ORIGIN_Y=608

# case4 2D 底图标定：1 px 对应的业务坐标单位 m。
# 文件 UE(x,y,z) 映射到 2D 图时：imageX = originX + y / unitsPerPx，imageY = originY + x / unitsPerPx。
VITE_CASE4_MAP_UNITS_PER_PX=0.11

# case4 2D 底图显示调整：对“底图 + 路线 + 点位 + UE”整体图层做显示缩放/旋转/平移。
# 不改变 originX/originY 的原图标定含义。
# 38 点 1m 走廊：相对 V2 通信页放大并上移，整条 L 落在底栏以上。
VITE_CASE4_MAP_IMAGE_SCALE=1.76
VITE_CASE4_MAP_IMAGE_ROTATION_DEG=0
VITE_CASE4_MAP_IMAGE_OFFSET_X=186.3
VITE_CASE4_MAP_IMAGE_OFFSET_Y=-432.7

# case4 2D 地图调参窗口：1 显示，0 隐藏；默认显示。
VITE_CASE4_MAP_DEBUG_SHOW=0
# case4 Reflection：构建时白名单注入。示例 BS 仅供模拟验证，不是真实标定。
CASE4_REFLECTION_ENABLE=true
CASE4_BS_XYZ=(-49.29,-26.04,0)

# case1：初始视角采用模型包围盒最长边归一为1、居中后的坐标，旋转为弧度。
# 交互只保留在本次case停留内；debug复制后手工改本文件，重启开发/重建生效。
VITE_CASE1_DEBUG=0
# case1 环境几何层 3D 初始参数
VITE_CASE1_GEOMETRY_CAMERA_POSITION=0.296214,0.042747,-0.09279
VITE_CASE1_GEOMETRY_CAMERA_TARGET=0.00117,-0.029938,-0.063326
VITE_CASE1_GEOMETRY_CAMERA_ZOOM=1
VITE_CASE1_GEOMETRY_MODEL_ROTATION=0,0,0
VITE_CASE1_GEOMETRY_MODEL_SCALE=1
VITE_CASE1_GEOMETRY_PAN_SPEED=1
VITE_CASE1_GEOMETRY_ROTATE_SPEED=1
VITE_CASE1_GEOMETRY_ZOOM_SPEED=1

# case1 电磁材质层 3D 初始参数
VITE_CASE1_MATERIAL_CAMERA_POSITION=0.317655,0.098586,-0.147801
VITE_CASE1_MATERIAL_CAMERA_TARGET=0.003976,-0.02448,-0.040635
VITE_CASE1_MATERIAL_CAMERA_ZOOM=1
VITE_CASE1_MATERIAL_MODEL_ROTATION=0,0,0
VITE_CASE1_MATERIAL_MODEL_SCALE=1
VITE_CASE1_MATERIAL_PAN_SPEED=1
VITE_CASE1_MATERIAL_ROTATE_SPEED=1
VITE_CASE1_MATERIAL_ZOOM_SPEED=1

# 热力矩形左上角，单位是底图像素，原点在图片左上角
VITE_CASE1_HEATMAP_X0=472
VITE_CASE1_HEATMAP_Y0=260
# 热力矩形右下角，不含该像素。范围是 [X0, X1) × [Y0, Y1)，必须落在底图宽高之内
VITE_CASE1_HEATMAP_X1=600
VITE_CASE1_HEATMAP_Y1=350
# 每个色块的边长，单位像素
VITE_CASE1_HEATMAP_CELL=4
# 色块之间的透明缝，单位像素。周期 = CELL + GAP
VITE_CASE1_HEATMAP_GAP=1
# 热力叠在底图上的透明度，范围 (0, 1]
VITE_CASE1_HEATMAP_ALPHA=0.9

# RF 视图调试信息。0 仍可滚轮缩放、左键旋转、右键平移和复位，只是不显示可复制配置。1 才显示。
# 把复制出的四行贴回这里，重启后作为启动时的缩放、旋转和平移。
VITE_CASE1_RF_VIEW_DEBUG=0
VITE_CASE1_RF_VIEW_SCALE=1.61
VITE_CASE1_RF_VIEW_ROTATION_DEG=0
VITE_CASE1_RF_VIEW_OFFSET_X=21.26
VITE_CASE1_RF_VIEW_OFFSET_Y=-29.02

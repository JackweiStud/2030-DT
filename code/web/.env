# --------case2------------
# case2 Web 构建时配置（Vite 注入；改完需重启 dev / 重新 build）
# 统一用本文件：dev / build 共用。不要再建 .env.development 覆盖同名项。
# （若存在 .env.local / .env.[mode].local，仍会按 Vite 规则覆盖本文件。）

# 控制文件串行轮询间隔（ms）；不是业务超时
# API 前缀写死同源 /api/case2（dev 由 Vite 代理到 127.0.0.1:3102），不进 env
VITE_CASE2_POLL_MS=1000

# 热力锚区（相对底图像素左上角）[X0,X1) × [Y0,Y1)
VITE_CASE2_HEATMAP_X0=750
VITE_CASE2_HEATMAP_Y0=400
VITE_CASE2_HEATMAP_X1=1200
VITE_CASE2_HEATMAP_Y1=700

# 马赛克：色块边长 + 透明缝（px）；周期 = CELL + GAP
VITE_CASE2_HEATMAP_CELL=4
VITE_CASE2_HEATMAP_GAP=1

# 热力层叠到底图的透明度 (0,1]
VITE_CASE2_HEATMAP_ALPHA=0.9

# CDF 显示点上限；N≤CAP 画完整台阶，N>CAP 才下采样
VITE_CASE2_CDF_POINT_CAP=256

# --------case3------------
# Start/ReInit 期间串行业务轮询间隔（ms）；不是业务超时
# API 前缀写死同源 /api/case3，不进 env
VITE_CASE3_POLL_MS=500

# ue_comm_map.png 标定原点（像素）
VITE_CASE3_MAP_ORIGIN_X=905
VITE_CASE3_MAP_ORIGIN_Y=445

# 1 px 对应的业务坐标单位m，文件 x/y 到图片 XY 时交换轴
VITE_CASE3_MAP_UNITS_PER_PX=0.11
